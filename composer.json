{
    "name": "actualizer/brevo-chat-widget",
    "description": "Actualize: Brevo Chat Widget - DSGVO-konforme Integration des Brevo Chat Widgets",
    "type": "shopware-platform-plugin",
    "version": "1.1.6",
    "license": "MIT",
    "authors": [
        {
            "name": "Actualize",
            "email": "plugin@actualize.de",
            "homepage": "https://actualize.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.4",
        "shopware/core": ">=6.7 <6.8"
    },
    "scripts": {
        "format": "docker run --rm -v $(pwd):/ext shopware/shopware-cli:latest extension format /ext",
        "check": "docker run --rm -v $(pwd):/ext shopware/shopware-cli:latest extension validate --full /ext"
    },
    "extra": {
        "shopware-plugin-class": "Act\\BrevoChatWidget\\ActBrevoChatWidget",
        "label": {
            "de-DE": "Actualize: Brevo Chat Widget",
            "en-GB": "Actualize: Brevo Chat Widget"
        },
        "description": {
            "de-DE": "DSGVO-konforme Integration des Brevo Chat Widgets in den Storefront, das den Chat erst nach Zustimmung über den Shopware Cookie Consent lädt und je Sales Channel steuerbar ist.",
            "en-GB": "GDPR-compliant integration of the Brevo chat widget into the storefront, loading the chat only after consent via the Shopware cookie consent and configurable per sales channel."
        },
        "manufacturerLink": {
            "de-DE": "https://actualize.de",
            "en-GB": "https://actualize.de"
        },
        "supportLink": {
            "de-DE": "https://actualize.de",
            "en-GB": "https://actualize.de"
        }
    },
    "autoload": {
        "psr-4": {
            "Act\\BrevoChatWidget\\": "src/"
        }
    }
}
